+/**
+ * Enables internal edge correction for this runtime BVH mesh. Its single-shape
+ * rigid body must enable collision notification to call the contact hook.
+ */
+bool BulletTriangleMeshShape::
+enable_internal_edge_adjustment() {
+  LightMutexHolder holder(BulletWorld::get_global_lock());
+  if (_bvh_shape == nullptr || _bvh_shape->getOptimizedBvh() == nullptr) {
+    return false;
+  }
+  if (_bvh_shape->getTriangleInfoMap() == nullptr) {
+    btGenerateInternalEdgeInfo(_bvh_shape, new btTriangleInfoMap);
+  }
+  return true;
 }
 
