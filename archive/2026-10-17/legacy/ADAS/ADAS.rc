FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,14,14,21,20
    LTEXT           "ADAS，版本 1.0",IDC_STATIC,42,14,114,8,SS_NOPREFIX
    LTEXT           "版权所有 (C) 2025",IDC_STATIC,42,26,114,8
    DEFPUSHBUTTON   "确定",IDOK,113,41,50,14,WS_GROUP
END

IDD_ADAS_DIALOG DIALOGEX 0, 0, 536, 318
STYLE DS_SYSMODAL | DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_APPWINDOW
CAPTION "ADAS智能驾驶仿真系统"
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    CONTROL         "",IDC_SCENE_STATIC,"Static",SS_BLACKFRAME,97,7,330,277
    LTEXT           "Static",IDC_TEXT_OUR_SPEED,435,65,77,15
    CONTROL         "",IDC_SLIDER_OUR_SPEED,"msctls_trackbar32",TBS_BOTH | TBS_NOTICKS | WS_TABSTOP,432,85,87,21
    CTEXT           "",IDC_WARNING_TEXT,191,14,143,12
    PUSHBUTTON      " 开始仿真",IDC_START_BUTTON,200,288,119,26
    LTEXT           "0s",IDC_TTC_VALUE,436,11,87,15
    LTEXT           "加速：W",IDC_STATIC,7,26,78,17
    LTEXT           "减速：S",IDC_STATIC,7,42,51,15
    LTEXT           "开始或暂停：space",IDC_STATIC,7,86,72,23
    CONTROL         "开启ACC(&C)",IDC_CHECK_ACC,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,6,112,54,10
    LTEXT           "期望时距（s）:",IDC_STATIC_TIMEGAP_LABEL,5,147,50,8
    EDITTEXT        IDC_EDIT_TIMEGAP,59,146,17,12,ES_AUTOHSCROLL | ES_NUMBER
